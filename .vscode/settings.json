{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.envFile": "${workspaceFolder}\\.env",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  "python.analysis.exclude": [
    "**/.git",
    "**/.venv",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/node_modules",
    "**/staticfiles",
    "**/media",
    "**/Dolg_APP/ml/dataset/external",
    "**/Dolg_APP/ml/dataset/hf_cache",
    "**/Dolg_APP/ml/dataset/cache",
    "backups",
    "logs",
    ".tmp",
    "htmlcov",
    "docs/final/generated"
  ],
  "python.analysis.useLibraryCodeForTypes": false,
  "python.analysis.indexing": false,
  "python.analysis.autoImportCompletions": false,
  "python.analysis.userFileIndexingLimit": 300,
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportOptionalSubscript": "none",
    "reportOptionalMemberAccess": "none",
    "reportOptionalCall": "none",
    "reportAttributeAccessIssue": "none",
    "reportGeneralTypeIssues": "none",
    "reportUnknownArgumentType": "none",
    "reportUnknownMemberType": "none",
    "reportUnknownVariableType": "none"
  },
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": false,
  "python.testing.pytestArgs": [
    "Dolg_APP/tests_guest.py",
    "Dolg_APP/tests_server_engines.py",
    "Dolg_APP/tests_tool_asset_smoke.py",
    "Dolg_APP/tests_ai_glossary.py"
  ],
  "ruff.configuration": "${workspaceFolder}\\pyproject.toml",
  "ruff.nativeServer": "on",
  "files.associations": {
    ".env.example": "dotenv",
    "*.env.example": "dotenv",
    "*.html": "django-html",
    "**/templates/**/*.html": "django-html",
    "Dockerfile*": "dockerfile"
  },
  "yaml.schemaStore.enable": true,
  "yaml.validate": true,
  "yaml.schemas": {
    "https://json.schemastore.org/docker-compose.json": [
      "deploy/docker-compose*.yml"
    ],
    "https://json.schemastore.org/kustomization.json": [
      "deploy/k8s/kustomization.yaml"
    ],
    "https://json.schemastore.org/kubernetes.json": [
      "deploy/k8s/django.yaml",
      "deploy/k8s/monitoring.yaml",
      "deploy/k8s/namespace.yaml",
      "deploy/k8s/networkpolicy.yaml",
      "deploy/k8s/nginx.yaml",
      "deploy/k8s/pdb.yaml",
      "deploy/k8s/postgres.yaml",
      "deploy/k8s/redis.yaml",
      "deploy/k8s/storage.yaml"
    ]
  },
  "sqltools.connections": [
    {
      "name": "DOLG SQLite dev",
      "driver": "SQLite",
      "database": "${workspaceFolder}\\db.sqlite3",
      "previewLimit": 50
    }
  ],
  "vs-kubernetes.namespace": "dolg",
  "vs-kubernetes.kubectl-path.windows": "C:\\Program Files\\Docker\\Docker\\resources\\bin\\kubectl.exe",
  "vscode-kubernetes.kubectl-path-windows": "C:\\Program Files\\Docker\\Docker\\resources\\bin\\kubectl.exe",
  "vs-kubernetes.kubeconfig": "${env:USERPROFILE}\\.kube\\config",
  "vs-kubernetes.knownKubeconfigs": [
    "${env:USERPROFILE}\\.kube\\config"
  ],
  "vs-kubernetes.kubectlVersioning": "user-provided",
  "vs-kubernetes.outputFormat": "yaml",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.env.windows": {
    "PYTHONUTF8": "1"
  },
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/__pycache__": true,
    "**/staticfiles": true,
    "**/media": true,
    "**/backups": true,
    "**/logs": true,
    "**/.tmp": true,
    "**/Dolg_APP/ml/dataset/external": true,
    "**/Dolg_APP/ml/dataset/hf_cache": true,
    "**/Dolg_APP/ml/dataset/cache": true,
    "**/*.parquet": true,
    "**/*.tar.gz": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/__pycache__": true,
    "**/Dolg_APP/ml/dataset/external": true,
    "**/Dolg_APP/ml/dataset/hf_cache": true,
    "**/Dolg_APP/ml/dataset/cache": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/__pycache__/**": true,
    "**/staticfiles/**": true,
    "**/media/**": true,
    "**/backups/**": true,
    "**/logs/**": true,
    "**/.tmp/**": true,
    "**/Dolg_APP/ml/dataset/external/**": true,
    "**/Dolg_APP/ml/dataset/hf_cache/**": true,
    "**/Dolg_APP/ml/dataset/cache/**": true,
    "**/*.parquet": true,
    "**/*.tar.gz": true
  }
}

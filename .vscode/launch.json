{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: runserver",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\manage.py",
      "args": [
        "runserver",
        "127.0.0.1:8000"
      ],
      "django": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}\\.env",
      "env": {
        "DJANGO_SETTINGS_MODULE": "Dolg_PR.settings"
      }
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-q"
      ],
      "justMyCode": true,
      "envFile": "${workspaceFolder}\\.env"
    }
  ]
}

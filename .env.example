# DOLG environment template
# Copy this file to .env or configure these variables in your deployment system.

# Development: True / 1 / yes / on / dev / debug
# Production/demo: False / 0 / no / off / release / prod
DEBUG=True
DJANGO_SETTINGS_MODULE=Dolg_PR.settings_dev

# Generate a unique value before production/demo deployment:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-before-deploy

ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.localhost,.trycloudflare.com,.ngrok-free.app,.ngrok.io
CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com,https://*.ngrok-free.app,https://*.ngrok.io

PAYMENT_BACKEND=stripe
PAYMENT_CURRENCY=RUB
STRIPE_PUBLIC_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Development default is console email backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=DOLG <noreply@dolg.local>

# Optional PostgreSQL production/demo database.
# If POSTGRES_DB is empty, the project uses SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 12-factor DATABASE_URL — приоритетнее POSTGRES_*. Если задан — settings.py
# парсит и переключает на Postgres. Используется docker-compose для связи
# web↔db через имя сервиса.
# DATABASE_URL=postgresql://dolg:changeme@db:5432/dolg

# Anthropic API (опционально). Без ключа — AI-чат в demo-режиме.
ANTHROPIC_API_KEY=

# HuggingFace token (опционально, но СИЛЬНО рекомендуется для импорта датасетов).
# Без токена анонимная загрузка часто зависает на 90+ МБ (Cloudflare rate-limit).
# Получить бесплатный токен: https://huggingface.co/settings/tokens (role: read).
# Используется в `python manage.py import_external_datasets --source open_schematics`
# и UI на /staff/ml-training/.
HF_TOKEN=

# Sentry (опционально, prod). Без DSN никаких внешних соединений.
# Установите через: pip install -r requirements-prod.txt
# SENTRY_DSN=https://example@sentry.io/12345
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=production

# Авто-superuser для свежей БД в Docker (entrypoint.sh):
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=DolgAdmin2026
DJANGO_SUPERUSER_EMAIL=admin@dolg.local

# Уровень логов: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# Опции Docker-compose:
HTTP_PORT=80
FAST_TESTS=                  # 1 — пропустить миграции в тестах
# COLLECTSTATIC_CLEAR=1      # очистить staticfiles перед сборкой (после удаления assets)
# USE_MANIFEST_STATIC=1      # production: включить ManifestStaticFilesStorage после collectstatic

# === Production-only сюрприз-чеки (срабатывают при DEBUG=False) ===
# При DEBUG=False скрипт scripts/check_prod_settings.py откажется стартовать,
# если SECRET_KEY = default, ALLOWED_HOSTS пуст, или EMAIL_BACKEND = console.
# Запустить вручную: python manage.py check_prod_settings

# DOLG environment template
# Copy this file to .env or configure these variables in your deployment system.

# Development: True / 1 / yes / on / dev / debug
# Production/demo: False / 0 / no / off / release / prod
DEBUG=True
DJANGO_SETTINGS_MODULE=Dolg_PR.settings_dev

# Generate a unique value before production/demo deployment:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-before-deploy

ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.localhost,.trycloudflare.com,.ngrok-free.app,.ngrok-free.dev,.ngrok.io
CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com,https://*.ngrok-free.app,https://*.ngrok-free.dev,https://*.ngrok.io

PAYMENT_BACKEND=stripe
PAYMENT_CURRENCY=RUB
STRIPE_PUBLIC_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Development default is console email backend. Docker production stack refuses
# console backend when DEBUG=False; set SMTP/transactional email or locmem only
# for CI smoke runs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=DOLG <noreply@dolg.local>

# Optional PostgreSQL production/demo database.
# If POSTGRES_DB is empty, the project uses SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis/Celery. Docker compose sets these to redis://redis:* automatically.
# For local dev without Redis, leave blank: settings.py falls back to in-memory.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# 12-factor DATABASE_URL — приоритетнее POSTGRES_*. Если задан — settings.py
# парсит и переключает на Postgres. Используется docker-compose для связи
# web↔db через имя сервиса.
# DATABASE_URL=postgresql://dolg:changeme@db:5432/dolg

# Local AI through Ollama. Install: winget install --id Ollama.Ollama --exact
# Pull a small model once: ollama pull qwen3:0.6b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_TIMEOUT_SEC=75
LOCAL_AI_TIMEOUT_SEC=75

# Public tunnel fallback instead of Cloudflare 1033.
# Set once with `ngrok config add-authtoken ...` or set NGROK_AUTHTOKEN for launcher auto-config.
NGROK_AUTHTOKEN=

# HuggingFace token (опционально, но СИЛЬНО рекомендуется для импорта датасетов).
# Без токена анонимная загрузка часто зависает на 90+ МБ (Cloudflare rate-limit).
# Получить бесплатный токен: https://huggingface.co/settings/tokens (role: read).
# Используется в `python manage.py import_external_datasets --source open_schematics`
# и UI на /staff/ml-training/.
HF_TOKEN=

# Sentry (опционально, prod). Без DSN никаких внешних соединений.
# Установите через: pip install -r requirements-prod.txt
# SENTRY_DSN=https://example@sentry.io/12345
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=production

# Prometheus machine token for /metrics. Docker/Kubernetes local examples use
# local-metrics-token-change-me; rotate for anything non-local.
METRICS_TOKEN=local-metrics-token-change-me

# Optional auto-superuser for a fresh Docker DB. Leave blank in production and
# create admins manually or inject one-time values through your deploy system.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Уровень логов: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# Опции Docker-compose:
HTTP_PORT=80
HTTP_BIND=0.0.0.0
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
FAST_TESTS=                  # 1 — пропустить миграции в тестах
# COLLECTSTATIC_CLEAR=1      # очистить staticfiles перед сборкой (после удаления assets)
# USE_MANIFEST_STATIC=1      # production: включить ManifestStaticFilesStorage после collectstatic

# === Production-only сюрприз-чеки (срабатывают при DEBUG=False) ===
# При DEBUG=False скрипт scripts/check_prod_settings.py откажется стартовать,
# если SECRET_KEY = default, ALLOWED_HOSTS пуст, или EMAIL_BACKEND = console.
# Запустить вручную: python manage.py check_prod_settings

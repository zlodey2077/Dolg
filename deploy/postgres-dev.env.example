POSTGRES_DB=dolg
POSTGRES_USER=dolg
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# Optional pgAdmin profile:
# docker compose --env-file deploy/.env.postgres.local -f deploy/docker-compose.postgres-dev.yml --profile tools up -d
PGADMIN_EMAIL=admin@dolg.local
PGADMIN_PASSWORD=local-pgadmin-password
PGADMIN_BIND=127.0.0.1
PGADMIN_PORT=5050

      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "thresholds"}, "thresholds": {"steps": [{"value": null, "color": "green"}, {"value": 0.1, "color": "orange"}, {"value": 1, "color": "red"}]}}, "overrides": []},
